# Ignore common large or unnecessary files for Cloudflare Pages/Workers
# Exclude node_modules entirely (Pages should use built assets only)
node_modules/

# Ignore git and editor files
.git/
.vscode/
*.log
.DS_Store

# Wrangler and build artifacts
wrangler.toml
.build/
dist/

# Exclude known large workerd binary paths
**/workerd/**
**/workerd/bin/**

# Archives
*.zip
*.tar.gz
*.tgz
